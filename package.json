{
  "name": "lifestyle-book-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "GITHUB_PAGES=true npm run build",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:pages": "npm run build:pages && PLAYWRIGHT_BASE_PATH=/lifestyle-book-mobile/ playwright test",
    "preview": "vite preview",
    "preview:lan:deploy": "bash scripts/deploy-lan-preview.sh",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android:check": "npm run cap:sync && ./android/gradlew -p android lint testDebugUnitTest assembleDebug bundleRelease",
    "ci": "npm run format && npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "idb": "^8.0.3",
    "plotly.js-basic-dist-min": "^3.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/plotly.js": "^3.0.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "22.x"
  }
}
